# OpenAI Provider
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Anthropic Provider
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# AWS Bedrock Provider (Optional - for open-source models)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-aws-secret-here
AWS_REGION=us-east-1

# LiteLLM Universal Router (Optional - for routing to multiple providers)
LITELLM_BASE_URL=http://localhost:4000  # If using internal LiteLLM instance
LITELLM_API_KEY=your-litellm-api-key-here  # If using authenticated instance

# Cloudflare (Phase 3 - for results dashboard)
# CLOUDFLARE_API_TOKEN=your-cloudflare-token-here
# CLOUDFLARE_ACCOUNT_ID=your-account-id-here
# CLOUDFLARE_RESULTS_API_KEY=your-results-api-key-here

# Optional: Other Provider API Keys (for LiteLLM routing)
# TOGETHER_API_KEY=your-together-key-here
# GROQ_API_KEY=your-groq-key-here
# HUGGINGFACE_API_KEY=your-huggingface-key-here
# COHERE_API_KEY=your-cohere-key-here
